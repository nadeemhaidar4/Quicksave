{
  "name": "QuickSave - Video Downloader",
  "short_name": "QuickSave",
  "description": "Download Instagram, TikTok, Facebook, Twitter videos instantly. Free, no signup.",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#080b16",
  "theme_color": "#7c6cfc",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "categories": ["utilities", "productivity"],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text":  "text",
      "url":   "url"
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Paste & Download",
      "short_name": "Paste",
      "url": "/?action=paste",
      "description": "Paste URL and download instantly",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
